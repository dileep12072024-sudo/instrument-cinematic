{
  "name": "instrument-cinematic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check-site.mjs",
    "test:wind": "node scripts/check-wind.mjs",
    "test:environment": "node scripts/check-environment.mjs",
    "test:interaction": "node scripts/check-panorama-look.mjs && node scripts/check-entrance-look.mjs",
    "test:geometry": "node scripts/check-building-clearances.mjs && node scripts/check-terrace-coping.mjs && node scripts/check-foliage-clearance.mjs",
    "deploy": "wrangler pages deploy dist --project-name instrument-cinematic"
  },
  "dependencies": {
    "lucide": "^0.577.0",
    "suncalc": "^2.0.2",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "vite": "^7.3.1",
    "wrangler": "^4.73.0"
  }
}
