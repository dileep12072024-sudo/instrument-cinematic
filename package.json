{
  "name": "instrument-cinematic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check-site.mjs",
    "test:wind": "node scripts/check-wind.mjs",
    "test:environment": "node scripts/check-environment.mjs",
    "test:interaction": "node scripts/check-panorama-look.mjs && node scripts/check-entrance-look.mjs",
    "test:resolution": "node scripts/check-resolution.mjs",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test:storm": "node scripts/check-storm.mjs",
    "test:geometry": "node scripts/check-building-clearances.mjs && node scripts/check-terrace-coping.mjs",
    "deploy": "wrangler pages deploy dist --project-name instrument-cinematic"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide": "^0.577.0",
    "suncalc": "^2.0.2",
    "three": "^0.183.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.7",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "meshoptimizer": "1.3.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "vite": "^7.3.1",
    "wrangler": "^4.73.0"
  }
}
